programa {//Verificador de votação
  funcao inicio() {
    inteiro idade

      escreva("Qual sua idade?")
      leia(idade)
      se(idade < 16){
        escreva("Você ainda não tem permissão por lei para votar")
      }senao{
        escreva("Você já tem permissão para votar!")

      }  
    
  }
}
