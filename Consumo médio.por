programa {
  funcao inicio() {
    real litros,quilometro,consumo_medio
    escreva("Qual a distância percorrida? ")
    leia(quilometro)
    escreva("Quantos litros de combustível foram gastos? ")
    leia(litros)
      consumo_medio = quilometro / litros
      escreva("O consumo médio do carro é: ",consumo_medio)





  }
}
