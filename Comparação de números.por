programa {
  funcao inicio() {
    inteiro numero
    escreva("Digite um número: ")
    leia(numero)
      se( numero < 0){
        escreva("O número é negativo")
      } senao se( numero == 0){
        escreva("O número é igual a zero")
      }senao{
        escreva("O número é positivo")
      }
    
    
  }
}
